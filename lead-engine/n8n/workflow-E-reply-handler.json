{
  "name": "Lead Engine — E: Reply Handler",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "lead-engine-reply", "options": {} },
      "id": "e5a10000-0000-4000-8000-00000000e001",
      "name": "Evolution Inbound",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "lead-engine-reply"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst d = b.data || b;\nconst num = String(d.key?.remoteJid || d.from || '').replace(/[^0-9]/g,'');\nconst text = d.message?.conversation || d.message?.extendedTextMessage?.text || d.body || '';\n// Belt-and-braces literal opt-out: runs BEFORE sentiment. Hard-stops on STOP/unsubscribe/remove wording (EN + AF).\nconst stop = /\\b(stop|unsubscribe|opt ?out|remove me|haal my af|verwyder asseblief|moenie my|los my)\\b/i.test(text);\nreturn [{ json: { phone_e164: num, body: text, stop } }];"
      },
      "id": "e5a10000-0000-4000-8000-00000000e002",
      "name": "Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=SET_SUPABASE_URL/rest/v1/prospects?phone_e164=eq.{{ $json.phone_e164 }}&select=id,business_name&limit=1",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey", "value": "SET_SUPABASE_SERVICE_KEY" },
          { "name": "Authorization", "value": "Bearer SET_SUPABASE_SERVICE_KEY" },
          { "name": "Accept-Profile", "value": "streamline_hq" }
        ] },
        "options": {}
      },
      "id": "e5a10000-0000-4000-8000-00000000e003",
      "name": "Find Prospect",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": { "options": { "version": 2 }, "combinator": "and", "conditions": [ { "leftValue": "={{ $('Extract').item.json.stop }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ] },
        "options": {}
      },
      "id": "e5a10000-0000-4000-8000-00000000e004",
      "name": "STOP word?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "x-api-key", "value": "SET_ANTHROPIC_API_KEY" },
          { "name": "anthropic-version", "value": "2023-06-01" },
          { "name": "content-type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5\",\n  \"max_tokens\": 200,\n  \"system\": \"Tag this WhatsApp reply to cold outreach about beauty-business websites. Return ONLY JSON: {\\\"sentiment\\\":\\\"hot|warm|cold|no\\\",\\\"suggested_reply\\\":\\\"...\\\",\\\"urgency\\\":\\\"high|med|low\\\"}. Definitions — hot: wants a meeting/quote/to start now. warm: genuinely interested, asking questions. cold: clearly positive but just bad timing (e.g. 'looks great, message me again after December'). no: ANY decline, disinterest, annoyance, suspicion, or unwillingness to be contacted — examples: 'no', 'nah', 'not interested', 'not now', 'we're good', 'who is this?', 'how did you get my number', 'please don't message me', 'remove me', 'stop'. RULE: if a reply seems even mildly unwilling, or you are unsure between cold and no, you MUST choose no. Err toward no.\",\n  \"messages\": [{\"role\":\"user\",\"content\": {{ JSON.stringify('Reply: ' + $('Extract').item.json.body) }} }]\n}",
        "options": {}
      },
      "id": "e5a10000-0000-4000-8000-00000000e006",
      "name": "Claude Sentiment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 120]
    },
    {
      "parameters": {
        "jsCode": "let s = { sentiment: 'no', suggested_reply: '', urgency: 'low' };\ntry { s = JSON.parse($('Claude Sentiment').item.json.content[0].text); } catch (e) { /* unparsable -> safest is to treat as opt-out */ }\nreturn [{ json: { ...s, raw: $('Claude Sentiment').item.json.content[0].text } }];"
      },
      "id": "e5a10000-0000-4000-8000-00000000e009",
      "name": "Parse Sentiment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=SET_SUPABASE_URL/rest/v1/replies",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey", "value": "SET_SUPABASE_SERVICE_KEY" },
          { "name": "Authorization", "value": "Bearer SET_SUPABASE_SERVICE_KEY" },
          { "name": "Content-Profile", "value": "streamline_hq" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prospect_id\": {{ JSON.stringify($('Find Prospect').item.json[0]?.id) }},\n  \"body\": {{ JSON.stringify($('Extract').item.json.body) }},\n  \"sentiment\": {{ JSON.stringify($('Parse Sentiment').item.json.sentiment) }},\n  \"ai_suggested_response\": {{ JSON.stringify($('Parse Sentiment').item.json.suggested_reply) }},\n  \"ai_tagged_at\": {{ JSON.stringify($now.toISO()) }}\n}",
        "options": {}
      },
      "id": "e5a10000-0000-4000-8000-00000000e007",
      "name": "Save Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 120]
    },
    {
      "parameters": {
        "conditions": { "options": { "caseSensitive": true, "version": 2 }, "combinator": "and", "conditions": [ { "leftValue": "={{ $('Parse Sentiment').item.json.sentiment }}", "rightValue": "no", "operator": { "type": "string", "operation": "equals" } } ] },
        "options": {}
      },
      "id": "e5a10000-0000-4000-8000-00000000e010",
      "name": "Decline?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 120]
    },
    {
      "parameters": {
        "chatId": "SET_TELEGRAM_CHAT_ID",
        "text": "=💬 Reply from {{ $('Find Prospect').item.json[0]?.business_name }} [{{ $('Parse Sentiment').item.json.sentiment }}]:\n\n{{ $('Extract').item.json.body }}\n\nSuggested: {{ $('Parse Sentiment').item.json.suggested_reply }}",
        "additionalFields": {}
      },
      "id": "e5a10000-0000-4000-8000-00000000e008",
      "name": "Telegram Reply Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1780, 220]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=SET_SUPABASE_URL/rest/v1/messages?prospect_id=eq.{{ $('Find Prospect').item.json[0].id }}&status=in.(pending_approval,pending_draft,approved)",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey", "value": "SET_SUPABASE_SERVICE_KEY" },
          { "name": "Authorization", "value": "Bearer SET_SUPABASE_SERVICE_KEY" },
          { "name": "Content-Profile", "value": "streamline_hq" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"status\": \"cancelled\",\n  \"error\": \"auto-cancelled: prospect opted out / declined\"\n}",
        "options": {}
      },
      "id": "e5a10000-0000-4000-8000-00000000e011",
      "name": "Cancel Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, -160]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=SET_SUPABASE_URL/rest/v1/prospects?id=eq.{{ $('Find Prospect').item.json[0].id }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "apikey", "value": "SET_SUPABASE_SERVICE_KEY" },
          { "name": "Authorization", "value": "Bearer SET_SUPABASE_SERVICE_KEY" },
          { "name": "Content-Profile", "value": "streamline_hq" },
          { "name": "Content-Type", "value": "application/json" }
        ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"popia_optout\": true,\n  \"popia_optout_at\": {{ JSON.stringify($now.toISO()) }},\n  \"status\": \"dead\"\n}",
        "options": {}
      },
      "id": "e5a10000-0000-4000-8000-00000000e005",
      "name": "Honour Opt-out",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, -160]
    },
    {
      "parameters": {
        "chatId": "SET_TELEGRAM_CHAT_ID",
        "text": "=🚫 Opted out: {{ $('Find Prospect').item.json[0]?.business_name }} ({{ $('Extract').item.json.phone_e164 }})\n\nReply: \"{{ $('Extract').item.json.body }}\"\n\nMarked dead, POPIA opt-out logged, pending messages cancelled.",
        "additionalFields": {}
      },
      "id": "e5a10000-0000-4000-8000-00000000e012",
      "name": "Telegram Opt-out",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1560, -160]
    }
  ],
  "connections": {
    "Evolution Inbound": { "main": [[{ "node": "Extract", "type": "main", "index": 0 }]] },
    "Extract": { "main": [[{ "node": "Find Prospect", "type": "main", "index": 0 }]] },
    "Find Prospect": { "main": [[{ "node": "STOP word?", "type": "main", "index": 0 }]] },
    "STOP word?": { "main": [[{ "node": "Cancel Messages", "type": "main", "index": 0 }], [{ "node": "Claude Sentiment", "type": "main", "index": 0 }]] },
    "Claude Sentiment": { "main": [[{ "node": "Parse Sentiment", "type": "main", "index": 0 }]] },
    "Parse Sentiment": { "main": [[{ "node": "Save Reply", "type": "main", "index": 0 }]] },
    "Save Reply": { "main": [[{ "node": "Decline?", "type": "main", "index": 0 }]] },
    "Decline?": { "main": [[{ "node": "Cancel Messages", "type": "main", "index": 0 }], [{ "node": "Telegram Reply Alert", "type": "main", "index": 0 }]] },
    "Cancel Messages": { "main": [[{ "node": "Honour Opt-out", "type": "main", "index": 0 }]] },
    "Honour Opt-out": { "main": [[{ "node": "Telegram Opt-out", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
