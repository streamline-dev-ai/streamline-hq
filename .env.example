VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Buffer Channel IDs (identifiers, not secrets — safe client-side)
VITE_BUFFER_INSTAGRAM_ID=
VITE_BUFFER_FACEBOOK_ID=
VITE_BUFFER_LINKEDIN_ID=

# Optional: set to "true" to show the in-app AI "Generate Captions" button
# (calls the paid Anthropic API). Left unset, captions come from folder .txt files.
VITE_ENABLE_AI_CAPTIONS=

# ── Server-side only — NEVER VITE_-prefixed (set as Supabase Edge Function secrets) ──
# Set via: supabase secrets set NAME=value   (or the Supabase dashboard → Edge Functions → Secrets)
#   BUFFER_API_KEY        used by the buffer-proxy function
#   ANTHROPIC_API_KEY     used by the generate-captions function
#
# ── Local ingestion script only (scripts/ingestPost.mjs) — keep in .env.local, never VITE_ ──
#   CLOUDINARY_CLOUD_NAME=dnlgohkcc
#   CLOUDINARY_API_KEY=
#   CLOUDINARY_API_SECRET=
